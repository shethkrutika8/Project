<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Project.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Custom CSS -->
    <link href="StyleSheet1.css" rel="stylesheet" />
</head>
<body>
    <form id="form1" runat="server">

        <!--Navbar-->
        <nav class="navbar navbar-expand-lg agrinavbar">
            <div class="container-fluid px-4">
                <!--Logo-->
                <a class="navbar-brand agri-logo" href="Dashboard.aspx">
                    AgriCulture
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!--Navigation-->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="Dashboard.aspx">
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="About.aspx">
                                About Us
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="Features.aspx">
                                Features
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= Request.FilePath.EndsWith("Products.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>" href="Products.aspx">
                                Products
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= Request.FilePath.EndsWith("Pricing.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>" href="Pricing.aspx">
                                Pricing
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= Request.FilePath.EndsWith("AIDiagnose.aspx", StringComparison.OrdinalIgnoreCase) ? "active" : "" %>" href="AIDiagnose.aspx">
                                AI Diagnose
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="Blog.aspx">
                                Blog
                            </a>
                        </li>
                    </ul>

                    <div class="nav-buttons">
                        <asp:Button ID="btnSignIn" runat="server" Text="Sign In" CssClass="btn-signin" PostBackUrl="Login.aspx" />
                        <asp:Button ID="btnGetStarted" runat="server" Text="Get Started" CssClass="btn-getstarted" PostBackUrl="Register.aspx" />
                    </div>
                </div>
            </div>
        </nav>
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <footer class="agri-footer">
            <div class="container">
                <p>
                    @2026 AgriConnect. All rights reserved.
                </p>
            </div>
        </footer>
    </form>
    <!-- Bootstrap JS -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>
</html>
